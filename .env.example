# Copy this file to ".env" to change settings. Every line is optional.
# No secrets are stored here: the session-signing key is generated automatically
# on first run into instance/secret.key (keep that file private).

# 0.0.0.0 = reachable from phones on your Wi-Fi.  127.0.0.1 = this computer only.
ERGOVEST_HOST=0.0.0.0
ERGOVEST_HTTP_PORT=8000

# Allow people to create their own member accounts from the sign-in page.
# Set to false after your demo group has registered.
ERGOVEST_ALLOW_REGISTRATION=true

# Sign-in lifetime: idle hours for a normal sign-in, days for "Keep me signed in".
ERGOVEST_SESSION_IDLE_HOURS=12
ERGOVEST_REMEMBER_DAYS=30

# Only set to true if you put the app behind HTTPS (cookies then get the Secure flag).
ERGOVEST_COOKIE_SECURE=false

# Testing only. Leave false: it lets the app open any serial-style path, not just real ports.
ERGOVEST_ALLOW_ANY_PORT=false
